# Shell-level env for `wrangler deploy` / CI. Copy to .env and fill.
# Wrangler auto-reads .env from project root for these names.

# === Cloudflare deploy credentials ===
# Create at: https://dash.cloudflare.com/profile/api-tokens  (Create Token > Custom token)
CLOUDFLARE_API_TOKEN=

# Dashboard top-right > copy "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# Zero Trust > Access > Applications > your imgbed app > Overview > "Application ID"
# Needed by scripts/token-*.sh to attach/remove per-token Access policies.
ACCESS_APP_ID=
